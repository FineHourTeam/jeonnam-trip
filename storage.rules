rules_version = '2';
// 경로 규약: content/{kind}/{contentId}/{file} — 운영 콘텐츠 사진 (공개 읽기, 관리자 쓰기)
//           users/{uid}/{file} — 개인 업로드 (본인만)
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    function isImageUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /content/{kind}/{contentId}/{file} {
      allow read: if true;
      allow write: if isAdmin() && isImageUnder10MB();
      allow delete: if isAdmin();
    }
    match /users/{uid}/{allPaths=**} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && isImageUnder10MB();
    }
  }
}
