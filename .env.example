# 웹 앱 환경변수 — 이 파일을 .env로 복사한 뒤 값을 채워요.
# VITE_ 로 시작하는 값은 빌드된 웹 코드에 그대로 들어가 공개돼요. 비밀 값은 여기에 넣지 마세요.

# Firebase 콘솔 → 프로젝트 설정 → 내 앱(웹)의 SDK 설정
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=jeonnam-trip
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 네이버 클라우드 플랫폼 → Maps 애플리케이션의 Client ID (웹 서비스 URL에 배포 도메인 등록 필요)
VITE_NAVER_MAP_CLIENT_ID=

# 카카오 개발자 → 내 애플리케이션 → 앱 키의 JavaScript 키
VITE_KAKAO_JS_KEY=

# 로컬 Firebase 에뮬레이터에 붙을지 여부 (true/false). 개인 설정은 .env.local에 따로 둬도 돼요.
VITE_USE_EMULATORS=false
