# Cloud Functions 파라미터 — 이 파일을 functions/.env로 복사한 뒤 값을 채워요.
# firebase deploy --only functions 때 이 값을 읽어요.
# 비밀 값(NAVER_MAP_CLIENT_SECRET, KAKAO_CLIENT_SECRET)은 여기에 두지 않고
# firebase functions:secrets:set <이름> --project jeonnam-trip 으로 Secret Manager에 넣어요.

# 네이버 클라우드 플랫폼 → Maps 애플리케이션의 Client ID (Directions 프록시용)
NAVER_MAP_CLIENT_ID=

# 카카오 개발자 → 내 애플리케이션 → 앱 키의 REST API 키 (카카오 로그인 토큰 교환용)
KAKAO_REST_API_KEY=
