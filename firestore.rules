rules_version = '2';
// 컬렉션 구조: src/shared/domain/collections.ts 와 한 세트. 클라이언트 연산을 바꾸면 같은 커밋에 규칙도 바꾼다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // 관리자 = admins/{uid} 문서 존재. 클라이언트에서는 admins를 쓸 수 없다 (콘솔·CLI로만 추가)
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── 운영 콘텐츠: 공개본만 누구나 읽기, 쓰기는 관리자만 ──
    // 목록 쿼리는 where("status", "==", "published")를 반드시 포함해야 통과한다.
    match /places/{id} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }
    match /festivals/{id} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }
    match /creatorCourses/{id} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }
    match /contentDrafts/{id} {
      allow read, write: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // ── 개인 코스: 소유자만. 저장 버전은 1씩만 증가 (오래된 저장이 최신을 덮어쓰지 못함) ──
    match /trips/{tripId} {
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.version == 1;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.version == resource.data.version + 1;
    }

    // ── 공유본: 활성 공유본은 링크(문서 id)를 아는 누구나 단건 조회, 목록·쓰기는 소유자만 ──
    match /shares/{shareId} {
      allow get: if resource.data.active == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.tripId == resource.data.tripId;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ── 개인 보관함·개인 장소·SNS 링크: 본인만 ──
    match /users/{uid}/{document=**} {
      allow read, write: if isSelf(uid);
    }
  }
}
